# Application
APP_ENV=development
FLASK_DEBUG=False
SECRET_KEY=generate-a-random-value-before-running
ALLOW_REGISTRATION=True
DEMO_MODE=True
# Optional local demo account. These values are consumed only by `flask seed-demo`.
DEMO_NAME=Demo User
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=Demo@12345

# Session and security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
SESSION_HOURS=8
MAX_CONTENT_LENGTH_MB=2
ENABLE_SECURITY_HEADERS=True
TRUST_PROXY_HEADERS=False

# Authentication protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=ohmycoin_app
DB_PASSWORD=set-a-local-development-password
DB_NAME=ohmycoin
DB_CONNECTION_TIMEOUT=10

# Docker Compose only
MYSQL_ROOT_PASSWORD=set-a-local-root-password
